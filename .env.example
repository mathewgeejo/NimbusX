# NimbusX local development configuration.
# Copy to .env. These database credentials are local-only defaults; production
# deployment is intentionally disabled in this foundation until the required
# identity, tenant-isolation, persistence, and job controls exist.

NIMBUSX_ENV=development
NIMBUSX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
NIMBUSX_ALLOWED_HOSTS=localhost,127.0.0.1
NIMBUSX_REQUIRE_API_KEY=false
NIMBUSX_API_KEYS=
NIMBUSX_NASA_TIMEOUT_SECONDS=20
NIMBUSX_NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NIMBUSX_RATE_LIMIT_PER_MINUTE=60
NIMBUSX_ANALYSIS_EXECUTION=background
NIMBUSX_MAX_WINDOW_DAYS=31
# Fixed migration deadline for the deprecated POST /api/weather adapter.
NIMBUSX_LEGACY_WEATHER_ADAPTER_SUNSET=2026-09-01T00:00:00Z
VITE_API_BASE_URL=http://localhost:8000

# These compose service URLs document the future persistence/job boundaries.
# The foundation API deliberately does not consume them yet.
NIMBUSX_DATABASE_URL=postgresql://nimbusx:nimbusx-local-only@postgres:5432/nimbusx
NIMBUSX_REDIS_URL=redis://redis:6379/0
POSTGRES_DB=nimbusx
POSTGRES_USER=nimbusx
POSTGRES_PASSWORD=nimbusx-local-only

# Private data-plane heartbeat only. The Helm chart mounts tls.crt and tls.key
# from an existing Secret and sets these values for its metadata heartbeat.
NIMBUSX_CONTROL_PLANE_HEARTBEAT_URL=
NIMBUSX_DATA_PLANE_ID=
NIMBUSX_DATA_PLANE_CLIENT_CERT=
NIMBUSX_DATA_PLANE_CLIENT_KEY=
